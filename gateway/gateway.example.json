      "listen_proto": "tcp",
      "upstream_addr": "backend:443",
      "security_provider": "tls",
      "verify": "server",
      "ca_path": "/etc/scg/ca.pem",
      "protocol_version": "tls1.3"
    },
    {
      "name": "web-decrypt-tls",
      "direction": "decrypt",
      "listen_addr": "0.0.0.0:8443",
      "listen_proto": "tcp",
      "upstream_addr": "localhost:8080",
      "upstream_proto": "tcp",
      "security_provider": "tls",
      "verify": "none"
    },
    {
