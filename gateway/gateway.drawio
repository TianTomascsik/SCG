t;&quot;&gt;Can use send traffic via:&lt;/div&gt;&lt;div style=&quot;&quot;&gt;- normal local:port&lt;/div&gt;&lt;div style=&quot;&quot;&gt;- redirect through IPtables&lt;/div&gt;&lt;div style=&quot;&quot;&gt;- UDS for higher throughput and latency&lt;/div&gt;&lt;div style=&quot;&quot;&gt;- Shared memmory via lib for min latency and max throughput&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fontColor=#000000;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=none;fillStyle=solid;direction=west;gradientDirection=north;gradientColor=#FFF2A1;shadow=1;size=20;pointerEvents=1;align=center;" vertex="1" parent="1"><mxGeometry x="19600" y="5880" width="170" height="182.5" as="geometry" /></mxCell><mxCell id="172" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="174" target="65" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="173" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="174" target="64" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="174" value="Interfaces where the gateway knows it acts as TPROXY&lt;div&gt;One for:&lt;br&gt;- normal traffic&lt;/div&gt;&lt;div&gt;-safey traffic&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fontColor=#000000;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=none;fillStyle=solid;direction=west;gradientDirection=north;gradientColor=#FFF2A1;shadow=1;size=20;pointerEvents=1;" vertex="1" parent="1"><mxGeometry x="20110" y="5770" width="140" height="90" as="geometry" /></mxCell><mxCell id="175" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="176" target="66" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="176" value="different local ips nand ports for different nettworktraffic (each ip:port combo is for one route)" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fontColor=#000000;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=none;fillStyle=solid;direction=west;gradientDirection=north;gradientColor=#FFF2A1;shadow=1;size=20;pointerEvents=1;" vertex="1" parent="1"><mxGeometry x="20100" y="5670" width="140" height="80" as="geometry" /></mxCell><mxCell id="177" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="180" target="181" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="20280" y="5895" /><mxPoint x="20280" y="5907" /></Array></mxGeometry></mxCell><mxCell id="178" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="180" target="182" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="20280" y="5895" /><mxPoint x="20280" y="5937" /></Array></mxGeometry></mxCell><mxCell id="179" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="180" target="70" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="20280" y="5895" /><mxPoint x="20280" y="5985" /></Array></mxGeometry></mxCell><mxCell id="180" value="UDS one for Sendig Data to the SCG and one for reciving. Each app gets own UDS. There are also extra ones for safety traffic&lt;br&gt;Becuase of internal scaduling there is only one returning UDS" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fontColor=#000000;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=none;fillStyle=solid;direction=west;gradientDirection=north;gradientColor=#FFF2A1;shadow=1;size=20;pointerEvents=1;" vertex="1" parent="1"><mxGeometry x="19940" y="5850" width="180" height="90" as="geometry" /></mxCell><mxCell id="181" value="UDS normal" style="rounded=1;whiteSpace=wrap;html=1;shadow=0;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="20380" y="5892.5" width="120" height="30" as="geometry" /></mxCell><mxCell id="182" value="UDS safety" style="rounded=1;whiteSpace=wrap;html=1;shadow=0;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="20380" y="5922.5" width="120" height="30" as="geometry" /></mxCell><mxCell id="183" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="186" target="86" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="184" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="186" target="87" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="185" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="186" target="88" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="186" value="Each app can request a SHMRB via grpc. there will be one for normal traffic one saftey. the retuining SHMRB will always send safety first" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fontColor=#000000;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=none;fillStyle=solid;direction=west;gradientDirection=north;gradientColor=#FFF2A1;shadow=1;size=20;pointerEvents=1;" vertex="1" parent="1"><mxGeometry x="20160" y="6147.5" width="140" height="90" as="geometry" /></mxCell><mxCell id="187" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="188" target="89" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="188" value="grpc interface for requesting UDS/SH