[Unit]
Description=Secure Communication Gateway
Documentation=file:///opt/scg/README.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=scg
Group=scg

# Gateway binary and config — override CONFIG_DIR via drop-in or environment file
# (systemd does not expand shell-style ${VAR:-default}, so the default is set here)
Environment=CONFIG_DIR=/etc/scg/config
EnvironmentFile=-/etc/scg/environment
ExecStart=/opt/scg/gateway --config-dir ${CONFIG_DIR} --watch

# Capabilities required for TPROXY/kTLS/raw sockets and Safety-class nice priority
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_SYS_NICE
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_SYS_NICE
NoNewPrivileges=yes

# Reload config on `systemctl reload SecureCommunicationGateway`
ExecReload=/bin/kill -HUP $MAINPID

# Restart policy (rate limit lives in [Unit])
Restart=on-failure
RestartSec=3

# Logging — journal captures stderr (where the gateway writes)
StandardOutput=journal
StandardError=journal
SyslogIdentifier=scg

# Resource limits
LimitNOFILE=65536
LimitMEMLOCK=infinity

# Hardening
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/log/scg
PrivateTmp=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
